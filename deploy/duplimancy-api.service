# /etc/systemd/system/duplimancy-api.service
[Unit]
Description=Duplimancy API
After=network.target postgresql.service

[Service]
User=duplimancy
WorkingDirectory=/srv/duplimancy/api
EnvironmentFile=/srv/duplimancy/.env
Environment=NODE_ENV=production
# Keep V8 well under the droplet's 512 MB.
ExecStart=/usr/bin/node --max-old-space-size=160 dist/server.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
