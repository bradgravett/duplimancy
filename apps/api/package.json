{
  "name": "@duplimancy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "esbuild src/server.ts src/migrate.ts src/gc.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --external:pg-native \"--banner:js=import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "gc": "tsx --env-file-if-exists=../../.env src/gc.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@duplimancy/shared": "workspace:*",
    "@fastify/cors": "10.0.1",
    "fastify": "5.1.0",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/pg": "8.11.10",
    "esbuild": "0.24.0",
    "tsx": "4.19.2"
  }
}
